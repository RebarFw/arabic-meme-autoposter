{
  "name": "arabic-meme-autoposter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/deployment-auth.test.mjs && vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:local": "wrangler d1 migrations apply arabic-meme-autoposter-jobs --local",
    "deploy": "node scripts/deploy.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "setup": "node scripts/admin.mjs setup",
    "status": "node scripts/admin.mjs status",
    "secrets:status": "node scripts/secret-status.mjs",
    "owner:start": "node scripts/owner.mjs start",
    "owner:status": "node scripts/owner.mjs status",
    "owner:diagnose": "node scripts/owner.mjs diagnose",
    "owner:finish": "node scripts/owner.mjs finish",
    "owner:import": "node scripts/owner.mjs import",
    "poll": "node scripts/admin.mjs poll",
    "polling:validate": "node scripts/admin.mjs polling:validate",
    "download:diagnose": "node scripts/admin.mjs download:diagnose",
    "download:probe": "node scripts/probe-download.mjs",
    "download:probe-apify": "node scripts/probe-apify.mjs",
    "apify:budget": "node scripts/admin.mjs apify:budget",
    "cloudflare:usage": "node scripts/admin.mjs cloudflare:usage",
    "cloudflare:validate": "node scripts/admin.mjs cloudflare:validate",
    "cloudflare:bootstrap": "node scripts/bootstrap-cloudflare-usage.mjs",
    "cloudflare:probe": "node scripts/admin.mjs cloudflare:probe",
    "apify:enforce-limit": "node scripts/admin.mjs apify:enforce-limit",
    "retry:download": "node scripts/retry-download.mjs",
    "recover:download": "node scripts/recover-download.mjs",
    "posts:refresh": "node scripts/refresh-posts.mjs",
    "retry:delivery": "node scripts/retry-rejected-delivery.mjs",
    "meta:diagnose": "node scripts/admin.mjs meta:diagnose",
    "meta:subscribe": "node scripts/admin.mjs meta:subscribe",
    "db:remote": "node scripts/wrangler.mjs d1 migrations apply arabic-meme-autoposter-jobs --remote",
    "secrets:install": "node scripts/install-secrets.mjs",
    "secrets:check": "node scripts/check-secrets.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260930.2",
    "@cloudflare/vitest-plugin": "1.3.4",
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11",
    "wrangler": "4.145.0"
  }
}
